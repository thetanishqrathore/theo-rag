# theo-rag runtime configuration. Copy to .env and adjust.
# Every value here overrides the default in src/utils/config.py.

# --- Infrastructure (docker compose binds these to 127.0.0.1) ---
DATABASE_URL=postgresql://raguser:dev_password@127.0.0.1:5432/theology_rag
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_EXPECTED_DIM=1024

# --- Working data (keep OUTSIDE the git checkout; absolute paths recommended) ---
RAW_DATA_PATH=/srv/theo-rag-data/raw
CANONICAL_PATH=/srv/theo-rag-data/canonical
LOG_PATH=/srv/theo-rag-data/logs

# --- Generation (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b
# Optional helper model; empty = use OLLAMA_MODEL for helper calls too.
SECONDARY_OLLAMA_MODEL=
OLLAMA_NUM_CTX=32768
# Blocking-request timeout (seconds). Reasoning models need generous limits.
OLLAMA_TIMEOUT=900
OLLAMA_KEEPALIVE=30m
RAG_GENERATION_TEMPERATURE=0.1
# Simultaneous generations per API process (run a single uvicorn worker).
RAG_GENERATION_MAX_CONCURRENCY=1

# --- Extraction tools ---
# Clough transcripts are ingested from the original DOC files.
TRANSCRIPT_SOURCE_FORMAT=doc
# LibreOffice (DOC/RTF conversion) and Marker 1.x (Dean topical PDFs).
TRANSCRIPT_DOC_SOFFICE_COMMAND=soffice
DEAN_DOC_SOFFICE_COMMAND=soffice
DEAN_PDF_MARKER_COMMAND=marker_single
DEAN_PDF_MARKER_TIMEOUT_SEC=1800

# --- API ---
# The built frontend is served by the API on the same origin, so CORS only
# matters for the Vite dev server or other origins.
API_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Corpus-specific metadata fixes ---
# Lesson numbers for Dean files whose names collide with another numbering scheme
# in the same book/topic folder (John: inferred from passage order; Israel: the
# Feasts study and the 2017 "Israel Special" series follow Israel_01..10).
# See docs/RESTORATION_NOTES.md.
DEAN_LESSON_OVERRIDES={"Jno015.htm": {"lesson_number": 14, "basis": "inferred_passage_order", "reason": "John 1:19-28; fills the 014 gap between 1998-John-013 (1:16-28) and the topical 1998-John-015; filename 015 collides"}, "Jno051.htm": {"lesson_number": 52, "basis": "inferred_passage_order", "reason": "John 6:51-59; fills the 052 gap between 1998-John-051 (6:41-51) and 053 (7:1-9); filename 051 collides"}, "Feasts_Dean_VV.htm": {"lesson_number": 11, "basis": "assigned_after_series", "reason": "unnumbered study in the Israel topic; placed after Israel_01..10"}, "2017-IsraelSpecial-GodIsFaithfulToIsraelAndUs-001.pdf": {"lesson_number": 12, "basis": "assigned_after_series", "reason": "2017 Israel Special part 1; parts 1-3 collide with Israel_01..03"}, "2017-IsraelSpecial-GodIsFaithfulToIsraelAndUs-002.pdf": {"lesson_number": 13, "basis": "assigned_after_series", "reason": "2017 Israel Special part 2"}, "2017-IsraelSpecial-GodIsFaithfulToIsraelAndUs-003.pdf": {"lesson_number": 14, "basis": "assigned_after_series", "reason": "2017 Israel Special part 3"}}
# Reviewed validation exceptions (source filename -> accepted checks). Genuine
# short lessons/outlines (73-613 words; source text fully extracted) and one PDF
# whose Marker heading depths are noisy but whose text is correct.
VALIDATION_ACCEPTED_EXCEPTIONS={"1Jno51.htm": {"checks": ["minimum_content"], "sha256": "2b8b4b742a42a2d85333bcbed5f21018a192c9cae4732a22ab5ea1d3f7603a78", "reason": "genuine short lesson; source text fully extracted, below block/word minimums (426 words)", "reviewer": "restoration 2026-10-31 (pending owner confirmation)"}, "2002-2John-014.htm": {"checks": ["minimum_content"], "sha256": "3c8742fdfff492f0c50954f37bc0c311538e45a17e8c29a033692895f45a86d6", "reason": "genuine short lesson; source text fully extracted, below block/word minimums (536 words)", "reviewer": "restoration 2026-10-31 (pending owner confirmation)"}, "1998-Galatians-019.htm": {"checks": ["minimum_content"], "sha256": "862485099cd54feca7b774450850b410acbcf083bd317c62a87a2ef926b1fd0b", "reason": "genuine short lesson; source text fully extracted, below block/word minimums (review lesson, 110 words)", "reviewer": "restoration 2026-10-31 (pending owner confirmation)"}, "1998-James-019.htm": {"checks": ["minimum_content"], "sha256": "2bfc25e2e13ea46bf5f43a1b26bff5266e1d25937369a04789b4f5cbf42310af", "reason": "genuine short lesson; source text fully extracted, below block/word minimums (73 words, mostly scripture)", "reviewer": "restoration 2026-10-31 (pending owner confirmation)"}, "2004-Revelation-059b.htm": {"checks": ["minimum_content"], "sha256": "1e0e54e6387a56b79f6343a7d0cf42b6adbe075713e351e5bcc879f0528e392b", "reason": "genuine short lesson; source text fully extracted, below block/word minimums (323 words)", "reviewer": "restoration 2026-10-31 (pending owner confirmation)"}, "2004-Revelation-174a.htm": {"checks": ["minimum_content"], "sha256": "69bd0b0203ef56022dbf1f08c2a818c1b399b5793d66f5f9234c7c865ca31ed1", "reason": "genuine short lesson; source text fully extracted, below block/word minimums (83 words)", "reviewer": "restoration 2026-10-31 (pending owner confirmation)"}, "2003-Genesis-062.htm": {"checks": ["minimum_content"], "sha256": "5442bd27d5fb76cce475e5155336bcc718ec7b89dcb37452fa