{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theo-rag.local/eval/benchmark/v1_schema.json",
  "title": "Corpus RAG Benchmark Case V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "corpus",
    "query",
    "history",
    "top_k",
    "retrieval_mode",
    "class_tags",
    "label_tier",
    "expected_mode",
    "must_refuse",
    "min_citations",
    "hierarchy_policy",
    "expected_source_tags",
    "gold_anchors",
    "silver_rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^v1-(clough|dean)-[0-9]{3}$"
    },
    "corpus": {
      "type": "string",
      "enum": [
        "clough",
        "dean"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
    },
    "history": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "retrieval_mode": {
      "type": "string",
      "enum": [
        "fast",
        "deep"
      ]
    },
    "class_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "label_tier": {
      "type": "string",
      "enum": [
        "gold",
        "silver"
      ]
    },
    "expected_mode": {
      "type": "string",
      "enum": [
        "confident",
        "narrow",
        "refuse"
      ]
    },
    "must_refuse": {
      "type": "boolean"
    },
    "min_citations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "hierarchy_policy": {
      "type": "string",
      "enum": [
        "optional",
        "expected",
        "not_applicable"
      ]
    },
    "expected_source_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "gold_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "terms"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contains_any"
            ]
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "silver_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_chunk_citation",
        "min_sentence_citation_coverage",
        "max_uncited_sentence_rate",
        "allow_no_hierarchy",
        "require_final_event"
      ],
      "properties": {
        "require_chunk_citation": {
          "type": "boolean"
        },
        "min_sentence_citation_coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "max_uncited_sentence_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "allow_no_hierarchy": {
          "type": "boolean"
        },
        "require_final_event": {
          "type": "boolean"
        }
      }
    }
  }
}
